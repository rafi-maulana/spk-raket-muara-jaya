{
  "functions": {
    "**/*.php": {
      "runtime": "vercel-php@0.7.2"
    }
  },
  "routes": [
    { "src": "^/assets/(.*)", "dest": "/assets/$1" },
    { "src": "^/uploads/(.*)", "dest": "/uploads/$1" },
    { "src": "^/admin/uploads/(.*)", "dest": "/admin/uploads/$1" },
    { "src": "^/$", "dest": "/index.php" },
    { "src": "^/admin/?$", "dest": "/admin/dashboard.php" },
    { "src": "^/(.*\\.php)$", "dest": "/$1" }
  ]
}
