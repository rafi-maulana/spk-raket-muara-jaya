{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.3",
      "excludeFiles": "{assets/uploads/**,uploads/**,admin/uploads/**}"
    }
  },
  "routes": [
    { "src": "^/assets/(.*)", "dest": "/assets/$1" },
    { "src": "^/uploads/(.*)", "dest": "/uploads/$1" },
    { "src": "^/admin/uploads/(.*)", "dest": "/admin/uploads/$1" },
    { "src": "^/(.*)", "dest": "/api/index.php" }
  ]
}
